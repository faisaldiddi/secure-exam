<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Users</title><link rel="stylesheet" href="/style.css"></head><body><%- include('nav',{user}) %><div class="container"><div class="row"><div><h1>Authorized Staff</h1><div class="table-wrap"><table><tr><th>Name</th><th>Email</th><th>Role</th></tr><% users.forEach(u=>{ %><tr><td><b><%= u.name %></b><br><small><%= u.staffCode %></small></td><td><%= u.email %></td><td><span class="badge"><%= u.role %></span></td></tr><% }) %></table></div></div><div class="card"><h2>Add Staff</h2><form method="post" action="/admin/users"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Temporary Password</label><input name="password" required></div><div class="field"><label>Role</label><select name="role"><option>ADMIN</option><option>PAPER_SETTER</option><option>REVIEWER</option></select></div><button class="btn">Create Staff</button></form></div></div></div></body></html>
