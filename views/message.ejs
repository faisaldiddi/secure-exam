<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> — EXAM SENTRY</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('nav', { user: locals.user || null }) %>
  <div class="container">
    <div class="card" style="max-width: 560px; margin: 60px auto; padding: 36px; text-align:center;">
      <span class="badge <%= title.toLowerCase().includes('denied') || title.toLowerCase().includes('revoked') ? 'badge-danger' : 'badge-ok' %>" style="margin-bottom:14px;">
        <%= title.toUpperCase() %>
      </span>
      <h1 style="color:#fff; margin:0 0 12px; font-size:26px;"><%= title %></h1>
      <p style="color:var(--ink-muted); font-size:15px; line-height:1.6; margin-bottom:28px;"><%= message %></p>
      
      <div style="display:flex; justify-content:center; gap:12px;">
        <a class="btn" href="/dashboard">Return to Dashboard</a>
        <a class="btn secondary" href="/login">Sign In Again</a>
      </div>
    </div>
  </div>

  <div class="footer">
    EXAM SENTRY &bull; "SECURE. MONITOR. TRACE."
  </div>
</body>
</html>
