<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Two-Factor Authentication — EXAM SENTRY</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('nav', { user: null }) %>
  <div class="container">
    <div class="card" style="max-width: 480px; margin: 50px auto; padding: 36px; text-align: center;">
      <div style="display:inline-block; margin-bottom: 16px;">
        <span class="badge">SECURITY CHALLENGE</span>
      </div>
      <h1 style="font-size: 26px; margin: 0 0 8px; color:#fff;">Two-Factor OTP Verification</h1>
      <p class="muted" style="margin-bottom: 24px;">
        Enter the 6-digit verification code sent to your authorized email.
      </p>

      <% if (error) { %>
        <div class="error-banner" style="text-align: left;">
          <span>&times;</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (locals.demoOtp) { %>
        <div class="success-banner" style="text-align: left; margin-bottom: 20px;">
          <span>&#10003;</span>
          <div>
            <b>Local Simulation OTP:</b> <span style="font-family:monospace; font-size:18px; color:#fff; font-weight:800; letter-spacing:2px;"><%= demoOtp %></span><br>
            <small style="color:var(--ink-muted);">In production, this code is delivered via SMTP.</small>
          </div>
        </div>
      <% } %>

      <form method="post" action="/otp">
        <div class="field" style="margin-bottom: 24px;">
          <input name="otp" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required autofocus
                 style="font-family: 'Courier New', monospace; font-size: 32px; letter-spacing: 12px; text-align: center; font-weight: 800; background: #060b17; border-color: var(--primary);"
                 placeholder="000000">
        </div>

        <button class="btn" style="width: 100%; padding: 12px;">
          Verify & Grant Session
        </button>
      </form>

      <div style="margin-top: 24px; font-size: 13px;">
        <a href="/login" class="muted" style="text-decoration: underline;">Cancel and return to login</a>
      </div>
    </div>
  </div>

  <div class="footer">
    EXAM SENTRY &bull; "SECURE. MONITOR. TRACE."
  </div>
</body>
</html>
