<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Review Queue</title><link rel="stylesheet" href="/style.css"></head><body><%- include('nav',{user}) %><div class="container"><div class="section-title"><h1>Review & Approval</h1><span class="badge">REVIEWER CONTROL</span></div><div class="table-wrap"><table><tr><th>Paper</th><th>Subject</th><th>Submitted</th><th>Action</th></tr><% if(!papers.length){ %><tr><td colspan="4" class="muted">No papers waiting for review.</td></tr><% } %><% papers.forEach(p=>{ %><tr><td><b><%= p.title %></b><br><small><%= p.id %></small></td><td><%= p.subject %></td><td><%= new Date(p.updatedAt).toLocaleString() %></td><td><a class="btn small secondary" href="/papers/<%= p.id %>/view">Inspect</a> <form style="display:inline" method="post" action="/papers/<%= p.id %>/approve"><button class="btn small">Approve & Lock</button></form></td></tr><% }) %></table></div></div></body></html>
