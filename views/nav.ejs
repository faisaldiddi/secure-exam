<div class="top">
  <div class="nav">
    <div class="brand-group">
      <a class="brand" href="/dashboard">
        <span class="brand-dot"></span> EXAM SENTRY
      </a>
      <div class="tagline">SECURE. MONITOR. TRACE.</div>
    </div>
    <div class="navlinks">
      <a href="/dashboard">Dashboard</a>
      <% if (user && user.role === 'AUTHORIZER') { %>
        <a href="/authorizer/whitelist">Whitelist</a>
        <a href="/authorizer/setters">Registered Setters</a>
        <a href="/authorizer/revoked">Revoked Users</a>
        <a href="/papers">All Papers</a>
      <% } else if (user && user.role === 'PAPER_SETTER') { %>
        <a href="/papers">My Papers</a>
        <a href="/papers/ai-wizard">AI Auto Generate</a>
        <a href="/papers/new">Manual Create</a>
        <a href="/papers/redefine">Redefine Paper</a>
      <% } %>
      <a href="/audit">Audit Trail</a>
      <a href="/security">Security Events</a>
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
      <% if (user) { %>
        <span class="badge <%= user.role === 'AUTHORIZER' ? 'badge-ok' : '' %>">
          <%= user.role %>: <%= user.email %>
        </span>
        <form method="post" action="/logout" style="margin:0;">
          <button class="btn secondary small">Logout</button>
        </form>
      <% } else { %>
        <a class="btn small" href="/login">Login</a>
        <a class="btn secondary small" href="/signup">Paper Setter Signup</a>
      <% } %>
    </div>
  </div>
</div>
