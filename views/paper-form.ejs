<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Paper Editor</title><link rel="stylesheet" href="/style.css"></head><body><%- include('nav',{user}) %><div class="container"><div class="card form-card"><div class="badge">SECURE PAPER EDITOR</div><h1><%= paper?.id ? 'Edit Paper' : 'Create Exam Paper' %></h1><p class="muted">Paper content is encrypted with AES-256-GCM before storage.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="<%= paper?.id ? '/papers/'+paper.id+'/edit' : '/papers' %>"><div class="row"><div class="field"><label>Paper Title</label><input name="title" value="<%= paper?.title||'' %>" required></div><div class="field"><label>Subject</label><input name="subject" value="<%= paper?.subject||'' %>"></div></div><div class="row"><div class="field"><label>Semester</label><input name="semester" value="<%= paper?.semester||'' %>"></div><div class="field"><label>Exam</label><input name="exam" value="<%= paper?.exam||'' %>" placeholder="End Semester"></div></div><div class="row"><div class="field"><label>Duration</label><input name="duration" value="<%= paper?.duration||'' %>" placeholder="2 Hours"></div><div class="field"><label>Total Marks</label><input name="marks" value="<%= paper?.marks||'' %>" placeholder="60"></div></div><div class="field"><label>Question Paper Content</label><textarea name="content" required placeholder="Q1. Explain supervised learning..."><%= paper?.content||'' %></textarea></div><button class="btn">Save Securely</button> <a class="btn secondary" href="/papers">Cancel</a></form></div></div></body></html>
